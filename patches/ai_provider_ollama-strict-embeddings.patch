@@ -225,6 +225,18 @@ class OllamaProvider extends OpenAiBasedProviderClientBase {
    */
   public function embeddings(string|EmbeddingsInput $input, string $model_id, array $tags = []): EmbeddingsOutput {
     $model_id = $this->getModel($model_id);
+    // Strict input handling: the OpenAI-compatible endpoint always truncates
+    // over-long input silently, so a "truncate" setting uses /api/embed.
+    if (array_key_exists('truncate', $this->configuration)) {
+      $this->loadClient();
+      $text = $input instanceof EmbeddingsInput ? $input->getPrompt() : $input;
+      $num_ctx = isset($this->configuration['num_ctx']) ? (int) $this->configuration['num_ctx'] : NULL;
+      $response = $this->controlApi->embed($text, $model_id, (bool) $this->configuration['truncate'], $num_ctx);
+      if (!isset($response['embeddings'][0]) || !is_array($response['embeddings'][0])) {
+        throw new AiRequestErrorException('Embeddings response missing embedding data.');
+      }
+      return new EmbeddingsOutput($response['embeddings'][0], $response, []);
+    }
     return parent::embeddings($input, $model_id, $tags);
   }
 
