--- a/src/OllamaControlApi.php
+++ b/src/OllamaControlApi.php
@@ -70,6 +70,33 @@ class OllamaControlApi {
     return $result;
   }
 
+  /**
+   * Embeddings through the native endpoint, with explicit input handling.
+   *
+   * Unlike the OpenAI-compatible /v1/embeddings endpoint, /api/embed honours
+   * "truncate": with FALSE, an input longer than the context is rejected
+   * (HTTP 400) instead of being silently cut.
+   *
+   * @param string $text
+   *   The input text.
+   * @param string $model
+   *   The model.
+   * @param bool $truncate
+   *   Whether Ollama may truncate an input that exceeds the context.
+   * @param int|null $num_ctx
+   *   The context length to use, or NULL for the model default.
+   *
+   * @return array
+   *   The decoded response, with "model" and "embeddings".
+   */
+  public function embed(string $text, string $model, bool $truncate, ?int $num_ctx = NULL): array {
+    $body = ['model' => $model, 'input' => $text, 'truncate' => $truncate];
+    if ($num_ctx) {
+      $body['options'] = ['num_ctx' => $num_ctx];
+    }
+    return Json::decode($this->makeRequest("api/embed", [], 'POST', $body)->getContents());
+  }
+
