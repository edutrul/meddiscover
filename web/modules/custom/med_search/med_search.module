<?php

/**
 * @file
 * Queue embedding work for published health topic revisions.
 */

use Drupal\node\NodeInterface;

/**
 * Implements hook_ENTITY_TYPE_insert() for node entities.
 */
function med_search_node_insert(NodeInterface $node): void {
  med_search_node_update($node);
}

/**
 * Implements hook_ENTITY_TYPE_update() for node entities.
 */
function med_search_node_update(NodeInterface $node): void {
  if ($node->bundle() !== 'med_health_topic' || !$node->isPublished()
    || !$node->isDefaultRevision() || $node->language()->getId() !== 'en') {
    return;
  }
  $search = \Drupal::service('med_search.search');
  $original = $node->getOriginal();
  if ($original && $original->isPublished() && $search->input($original) === $search->input($node)) {
    return;
  }
  \Drupal::queue('med_topic_embedding')->createItem((int) $node->id());
}
