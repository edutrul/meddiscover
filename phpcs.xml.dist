<?xml version="1.0"?>
<ruleset name="medDiscover">
  <description>Drupal standards for custom runtime PHP.</description>
  <file>web/modules/custom/med_content/src</file>
  <file>web/modules/custom/med_search</file>
  <file>web/modules/custom/med_activation</file>
  <arg name="extensions" value="php,module,install,inc"/>
  <rule ref="Drupal"/>
</ruleset>
